<Window x:Class="gyakorlas.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:gyakorlas"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8.5*"/>
            <RowDefinition Height="0.5*"/>
        </Grid.RowDefinitions>
        <!--<Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
        </Grid>-->
        <Label Content="Home"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"/>
        <Label Content="About"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               />
        <Label Content="Prices"
               HorizontalAlignment="Right"
               VerticalAlignment="Center"
               />
        <Button Content="Exit"
               HorizontalAlignment="Right"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30*"/>
                <ColumnDefinition Width="70*"/>
            </Grid.ColumnDefinitions>

            <ComboBox Grid.Row="1"
                  HorizontalAlignment="Center">
                <ComboBoxItem Content="Szereted"/>
                <ComboBoxItem Content="A"/>
                <ComboBoxItem Content="Hal"/>
                <ComboBoxItem Content="Rudat"/>
                <ComboBoxItem Content="?"/>
            </ComboBox>
            <!--<Button
            Grid.Row="1"
            Grid.Column="2"
            Content="MAIN"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"/>-->
            <Label Content="Személyes adatok"
                   Grid.Row="1"
                   Grid.Column="2"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
            <Label Content="Név:"
                   Grid.Row="1"
                   Grid.Column="2"
                   Margin="0,50,0,0"/>
            <TextBox
                Grid.Column="1"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                MinHeight="20"
                MinWidth="90"
                Margin="69,50"
                />
            <Label Content="Kezdő dátum:"
                Grid.Row="1"
                Grid.Column="2"
                   Margin="0,110,0,0"/>
            <TextBox
                Grid.Column="1"
                Margin="100,110,332,232"/>
            <Label
                Content="Vég. dátum"
                Grid.Row="1"
                Grid.Column="2"
                HorizontalAlignment="Right"
                Margin="0,110,170,0"/>
            <TextBox
                Grid.Column="1"
                Margin="400,110,39,232"/>
            <Label
                Content="Fizetés típusa:"
                Grid.Row="1"
                Grid.Column="2"
                Margin="0, 170"/>
            <ComboBox
                Grid.Column="1"
                Margin="90,170,350,170">
                <ComboBoxItem/>
                <ComboBoxItem Content="Kártya"/>
                <ComboBoxItem Content="Készpénz"/>
            </ComboBox>
            <CheckBox
                Content="Egyéb személyek"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Margin="0,0,0,120" Checked="CheckBox_Checked" Unchecked="CheckBox_Unchecked"/>

            <Label x:Name="label" 
                Content="Személyek száma:"
                   Grid.Row="1"
                   Grid.Column="2"
                   VerticalAlignment="Bottom"
                   Margin="15,0,0,25"/>
            <TextBox
                x:Name="textbox"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Margin="120,0,320,28"/>
            <Button
                x:Name="button"
                Content="Mentés"
                Grid.Row="1"
                Grid.Column="2"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Margin="0,0,30,30"/>
        </Grid>
        <Label Content="Fish Sticks"
               
               VerticalAlignment="Center"
               />
        <Label Content="©"
               
               HorizontalAlignment="Right"
               VerticalAlignment="Top"
               />
        <!--<Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
            </Grid.RowDefinitions>
        </Grid>-->
    </Grid>
</Window>
